# Read-only fork input. Keep real credentials in the ignored .env file.
ALCHEMY_MONAD_RPC=
PYTH_API_KEY=

# Deferred until access is available: Monad mainnet fork, virtual chain ID 999143.
TENDERLY_ACCESS_KEY=
TENDERLY_ACCOUNT_SLUG=
TENDERLY_PROJECT_SLUG=
TENDERLY_RPC=
TENDERLY_DELIVERY_CHANNEL_ID=
REHEARSAL_SAFE_SALT=1

# Current staging: Monad testnet. Either RPC name is accepted by testnet_stage.py.
MONAD_TESTNET_RPC=
ALCHEMY_MONAD_TESTNET_RPC=
FUNDED_DEPLOYER_PRIVATE_KEY=
TESTNET_GOVERNOR=
TESTNET_GUARDIAN=
TESTNET_TREASURY=

# Public deployment inputs. A supplied DEPLOYER must match the signing key if both are present.
DEPLOYER=
DEPLOY_CONFIG=reports/deployment/testnet-config.json
DEPLOY_OUTPUT=reports/deployment/testnet-manifest.json
