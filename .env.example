# Read-only fork input. Keep real credentials in the ignored .env file.
ALCHEMY_MONAD_RPC=
PYTH_API_KEY=

# Tenderly staging: fresh Monad mainnet fork, virtual chain ID 999143.
TENDERLY_ACCESS_KEY=
TENDERLY_ACCOUNT_SLUG=
TENDERLY_PROJECT_SLUG=
TENDERLY_RPC=
TENDERLY_DELIVERY_CHANNEL_ID=
REHEARSAL_SAFE_SALT=1

# Friday only: native gas/timing and optional Mera P-256 measurements.
MONAD_TESTNET_RPC=
ALCHEMY_MONAD_TESTNET_RPC=

# Deployment inputs. Public addresses only; use a keystore or hardware wallet for signing.
DEPLOYER=
DEPLOY_CONFIG=reports/deployment/tenderly-config.json
DEPLOY_OUTPUT=reports/deployment/tenderly-manifest.json
